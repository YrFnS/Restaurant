# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Staff authentication
# Use a cryptographically random value of at least 32 characters in production.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SESSION_TTL_SECONDS="28800"

# NextAuth compatibility (remove after the authentication dependency decision)
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# KDS realtime service
KDS_REALTIME_URL="http://localhost:3003/broadcast"
NEXT_PUBLIC_KDS_PORT="3003"
