# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentication and customer access
# Use independent cryptographically random values of at least 32 characters in production.
AUTH_SECRET="replace-with-a-long-random-session-secret"
AUTH_PIN_PEPPER="replace-with-a-different-long-random-pin-pepper"
AUTH_ORDER_ACCESS_SECRET="replace-with-a-different-long-random-order-access-secret"
AUTH_CUSTOMER_ACCESS_SECRET="replace-with-a-different-long-random-customer-access-secret"
RATE_LIMIT_SECRET="replace-with-a-different-long-random-rate-limit-secret"
AUTH_SESSION_TTL_SECONDS="28800"
AUTH_SESSION_IDLE_SECONDS="1800"

# Browser request protection
# Leave empty for same-origin only, or add trusted origins as a comma-separated list.
APP_ALLOWED_ORIGINS=""

# NextAuth compatibility (remove after the authentication dependency decision)
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# KDS realtime service and durable outbox worker
KDS_REALTIME_URL="http://localhost:3003/broadcast"
NEXT_PUBLIC_KDS_PORT="3003"
# Used as a Bearer token by the scheduler calling /api/internal/kds-outbox.
KDS_OUTBOX_SECRET="replace-with-a-different-long-random-kds-outbox-secret"
