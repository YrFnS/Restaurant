// Restaurant — Restaurant Management Platform
// PostgreSQL schema (bilingual EN/AR, KDS with unique URLs, modifier groups, courses)
// All business values are managed from the admin panel — DB defaults are minimal/empty.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  dine_in
  takeout
  delivery
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  completed
  cancelled
}

enum OrderItemStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum PaymentMethod {
  cash
  card
  split
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  partially_refunded
  refunded
  voided
}

enum StaffRole {
  owner
  admin
  manager
  cashier
  server
  cook
  bartender
  host
  inventory_manager
  analyst
  staff
}

enum TableStatus {
  open
  seated
  ordered
  served
  paid
  cleaning
  reserved
}

enum TableShape {
  square
  round
}

enum ReservationStatus {
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum WaitlistStatus {
  waiting
  notified
  seated
  cancelled
  no_show
}

enum CashMovementType {
  payin
  payout
  drop
  sale
  refund
  adjustment
  opening_float
  closing_adjustment
}

enum KdsScreenType {
  prep
  expo
  all
}

enum KdsLayoutType {
  grid
  compact
}

enum DynamicPricingType {
  happy_hour
  lunch_special
  surge
}

enum PaymentEventType {
  capture
  refund
  void
  adjustment
}

enum PaymentEventStatus {
  pending
  succeeded
  failed
  voided
}

enum CashRegisterSessionStatus {
  open
  closed
}

// ─── Restaurant-wide settings (singleton) ───
model RestaurantSettings {
  id                    String   @id @default("1")
  nameEn                String   @default("")
  nameAr                String   @default("")
  taglineEn             String   @default("")
  taglineAr             String   @default("")
  descriptionEn         String   @default("")
  descriptionAr         String   @default("")
  phone                  String   @default("")
  email                  String   @default("")
  addressEn              String   @default("")
  addressAr              String   @default("")
  latitude               Float    @default(0)
  longitude              Float    @default(0)
  taxRate                Float    @default(0)
  // P1 exact value; scale 1_000_000. Globally omitted unless explicitly selected.
  taxRateMicros          BigInt   @default(0)
  currency               String   @default("USD")
  currencySymbol         String   @default("$")
  deliveryFee            Float    @default(0)
  deliveryFeeMinor       BigInt   @default(0)
  minDeliveryOrder       Float    @default(0)
  minDeliveryOrderMinor  BigInt   @default(0)
  deliveryRadiusKm       Float    @default(0)
  avgPrepTimeMin         Int      @default(20)
  tipPresets             String   @default("10,15,20")
  openTime               String   @default("09:00")
  closeTime              String   @default("23:00")
  logoUrl                 String   @default("")
  heroImageUrl            String   @default("")
  facebookUrl             String   @default("")
  instagramUrl            String   @default("")
  twitterUrl              String   @default("")
  whatsappUrl             String   @default("")
  giftCardAmounts         String   @default("25,50,75,100")
  statsOrdersServed       Int      @default(0)
  statsHappyCustomers     Int      @default(0)
  statsYearsService       Int      @default(0)
  // KDS timing thresholds (minutes)
  kdsGreenMin             Int      @default(10)
  kdsYellowMin            Int      @default(18)
  kdsRedMin               Int      @default(25)
  soundOnNewTicket        Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// ─── Menu ───
model MenuCategory {
  id           String     @id @default(cuid())
  nameEn       String
  nameAr       String
  icon         String     @default("🍽️")
  color        String     @default("#f59e0b")
  sortOrder    Int        @default(0)
  isAvailable  Boolean    @default(true)
  // Which kitchen station(s) handle this category (comma-separated station slugs, empty = all)
  stationSlugs String     @default("")
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id              String          @id @default(cuid())
  nameEn          String
  nameAr          String
  descriptionEn   String          @default("")
  descriptionAr   String          @default("")
  price           Float
  priceMinor      BigInt          @default(0)
  image           String          @default("")
  isAvailable     Boolean         @default(true)
  isPopular       Boolean         @default(false)
  isSpecial       Boolean         @default(false)
  isNew           Boolean         @default(false)
  preparationTime Int             @default(15)
  calories        Int             @default(0)
  // comma-separated allergens: gluten, dairy, nuts, eggs, seafood, soy, sesame
  allergens       String          @default("")
  // comma-separated dietary: vegetarian, vegan, gluten_free, halal, spicy
  dietary         String          @default("")
  sortOrder       Int             @default(0)
  categoryId      String
  category        MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups  ModifierGroup[]
  orderItems      OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Modifier groups: required/optional, single/multi-select, priced options
model ModifierGroup {
  id         String           @id @default(cuid())
  nameEn     String
  nameAr     String
  isRequired Boolean          @default(false)
  minSelect  Int              @default(0)
  maxSelect  Int              @default(1) // 1 = single, >1 = multi
  sortOrder  Int              @default(0)
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ModifierOption {
  id         String        @id @default(cuid())
  nameEn     String
  nameAr     String
  price      Float         @default(0)
  priceMinor BigInt        @default(0)
  isDefault  Boolean       @default(false)
  // preset tag: none, no, extra, side, light — for kitchen readability
  preset     String        @default("none")
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

// ─── Customers ───
model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String          @unique
  email            String?
  loyaltyPoints    Int             @default(0)
  totalSpent       Float           @default(0)
  totalSpentMinor  BigInt          @default(0)
  visits           Int             @default(0)
  notes            String          @default("")
  orders           Order[]
  reservations     Reservation[]
  waitlistEntries  WaitlistEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ─── Orders ───
model Order {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  type                OrderType        @default(dine_in)
  status              OrderStatus      @default(pending)
  customerName        String           @default("")
  customerPhone       String           @default("")
  deliveryAddress     String?
  notes               String?
  subtotal            Float            @default(0)
  subtotalMinor       BigInt           @default(0)
  taxAmount           Float            @default(0)
  taxAmountMinor      BigInt           @default(0)
  deliveryFee         Float            @default(0)
  deliveryFeeMinor    BigInt           @default(0)
  discountAmount      Float            @default(0)
  discountAmountMinor BigInt           @default(0)
  tipAmount           Float            @default(0)
  tipAmountMinor      BigInt           @default(0)
  total               Float            @default(0)
  totalMinor          BigInt           @default(0)
  paymentMethod       PaymentMethod    @default(cash)
  paymentStatus       PaymentStatus    @default(unpaid)
  // who took the order
  serverName          String           @default("")
  tableId             String?
  table               RestaurantTable? @relation(fields: [tableId], references: [id])
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id])
  items               OrderItem[]
  paymentEvents       PaymentEvent[]
  estimatedReady      DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String
  menuItem        MenuItem        @relation(fields: [menuItemId], references: [id])
  quantity        Int             @default(1)
  unitPrice       Float
  unitPriceMinor  BigInt          @default(0)
  // JSON string of selected modifier options [{id,nameEn,nameAr,price}]
  modifiers       String          @default("[]")
  notes           String?
  totalPrice      Float
  totalPriceMinor BigInt          @default(0)
  status          OrderItemStatus @default(pending)
  // which kitchen station handles this item
  stationSlug     String          @default("")
  // course number for course firing (1 = first course, 2 = main, etc.)
  course          Int             @default(1)
  hold            Boolean         @default(false) // held until expo fires it
  firedAt         DateTime?
  readyAt         DateTime?
  seatNumber      Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ─── Tables / Floor ───
model RestaurantTable {
  id           String        @id @default(cuid())
  number       Int           @unique
  capacity     Int           @default(4)
  section      String        @default("main") // main, patio, private, bar
  status       TableStatus   @default(open)
  shape        TableShape    @default(square)
  x            Float         @default(0)
  y            Float         @default(0)
  width        Float         @default(80)
  height       Float         @default(80)
  serverName   String        @default("")
  seatedAt     DateTime?
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Reservations ───
model Reservation {
  id            String            @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int
  tableId       String?
  table         RestaurantTable?  @relation(fields: [tableId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  dateTime      DateTime
  status        ReservationStatus @default(confirmed)
  occasion      String?
  preference    String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ─── Waitlist ───
model WaitlistEntry {
  id            String         @id @default(cuid())
  customerName  String
  customerPhone String
  partySize     Int
  status        WaitlistStatus @default(waiting)
  estimatedWait Int            @default(15)
  notes         String?
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  seatedAt      DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Offers / Promos ───
model SpecialOffer {
  id                  String   @id @default(cuid())
  titleEn             String
  titleAr             String
  descriptionEn       String   @default("")
  descriptionAr       String   @default("")
  discountPercent     Float    @default(0)
  discountBasisPoints Int      @default(0)
  image               String   @default("")
  isActive            Boolean  @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PromoCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  discountPercent     Float    @default(0)
  discountBasisPoints Int      @default(0)
  isActive            Boolean  @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Loyalty ───
model RewardTier {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  points    Int
  icon      String   @default("🎁")
  tier      String   @default("bronze") // bronze, silver, gold, platinum
  perkEn    String   @default("")
  perkAr    String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  amount        Float
  amountMinor   BigInt    @default(0)
  balance       Float
  balanceMinor  BigInt    @default(0)
  purchaserName String
  recipientName String
  message       String?
  template      String    @default("birthday")
  isRedeemed    Boolean   @default(false)
  redeemedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Feedback / Testimonials / Newsletter ───
model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String?
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  commentEn String
  commentAr String
  avatar    String   @default("")
  stars     Int      @default(5)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─── Staff ───
model Employee {
  id              String     @id @default(cuid())
  name            String
  pin             String     @unique
  role            StaffRole  @default(staff)
  hourlyWage      Float      @default(15.0)
  hourlyWageMinor BigInt     @default(0)
  isActive        Boolean    @default(true)
  email           String?
  phone           String?
  clockedIn       Boolean    @default(false)
  lastClockIn     DateTime?
  lastClockOut    DateTime?
  schedules       Schedule[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Schedule {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      @default(1)
  startTime  String   @default("09:00")
  endTime    String   @default("17:00")
  role       String   @default("Server")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Inventory ───
model Ingredient {
  id                String   @id @default(cuid())
  name              String
  unit              String   @default("pcs")
  quantity          Float    @default(0)
  lowThreshold      Float    @default(10)
  costPerUnit       Float    @default(0)
  // Unit cost uses scale 1_000_000 during the compatibility window.
  costPerUnitMicros BigInt   @default(0)
  supplier          String?
  category          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

model WasteLog {
  id             String   @id @default(cuid())
  ingredientId   String?
  ingredientName String   @default("")
  quantity       Float    @default(0)
  reason         String   @default("expired")
  notes          String?
  reportedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  supplier       String
  notes          String?
  status         String   @default("draft")
  totalCost      Float    @default(0)
  totalCostMinor BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

// ─── Cash registers, sessions, and drawer ledger ───
model CashRegister {
  id                                String                @id
  code                              String                @unique(map: "CashRegister_code_key")
  name                              String
  deviceId                          String                @unique(map: "CashRegister_deviceId_key")
  location                          String                @default("")
  discrepancyApprovalThresholdMinor BigInt                @default(0)
  isActive                          Boolean               @default(true)
  sessions                          CashRegisterSession[]
  createdAt                         DateTime              @default(now())
  updatedAt                         DateTime              @updatedAt

  @@index([isActive, name], map: "CashRegister_active_name_idx")
}

model CashRegisterSession {
  id                String                    @id
  registerId        String
  register          CashRegister              @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openKey           String
  status            CashRegisterSessionStatus @default(open)
  openingFloatMinor BigInt
  openedById        String
  openedByName      String                    @default("")
  openedAt          DateTime                  @default(now())
  closedAt          DateTime?
  close             CashRegisterClose?
  cashEntries       CashDrawerEntry[]
  paymentEvents     PaymentEvent[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([registerId, openKey], map: "CashRegisterSession_register_openKey_key")
  @@index([registerId, openedAt(sort: Desc)], map: "CashRegisterSession_register_openedAt_idx")
  @@index([openedById, status], map: "CashRegisterSession_openedBy_status_idx")
}

model CashRegisterClose {
  id                String              @id
  sessionId         String              @unique(map: "CashRegisterClose_sessionId_key")
  session           CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  closeKey          String              @unique(map: "CashRegisterClose_closeKey_key")
  expectedCashMinor BigInt
  countedCashMinor  BigInt
  discrepancyMinor  BigInt
  thresholdMinor    BigInt
  approvalRequired  Boolean             @default(false)
  approvedById      String?
  approvedByName    String?
  approvalReason    String?
  closedById        String
  closedByName      String              @default("")
  note              String?
  createdAt         DateTime            @default(now())

  @@index([createdAt(sort: Desc)], map: "CashRegisterClose_createdAt_idx")
  @@index([approvedById, createdAt(sort: Desc)], map: "CashRegisterClose_approvedBy_createdAt_idx")
}

model CashDrawerEntry {
  id                String               @id @default(cuid())
  type              CashMovementType     @default(payin)
  amount            Float                @default(0)
  amountMinor       BigInt               @default(0)
  note              String?
  createdBy         String?
  registerSessionId String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  @@index([registerSessionId, createdAt(sort: Desc)], map: "CashDrawerEntry_registerSession_createdAt_idx")
}

// ─── Notifications ───
model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── KDS: Stations + Screens (each screen = unique URL) ───
model KitchenStation {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  icon          String   @default("ChefHat")
  color         String   @default("#f59e0b")
  targetPrepMin Int      @default(15)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model KitchenScreen {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @default("")
  // comma-separated station slugs to display; empty = all stations
  stationFilter  String        @default("")
  screenType     KdsScreenType @default(prep)
  layoutType     KdsLayoutType @default(grid)
  autoRefreshSec Int           @default(10)
  showCompleted  Boolean       @default(false)
  maxOrders      Int           @default(0)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

// ─── Dynamic Pricing (happy hour etc.) ───
model DynamicPricing {
  id               String             @id @default(cuid())
  nameEn           String
  nameAr           String
  type             DynamicPricingType @default(happy_hour)
  multiplier       Float              @default(1.0)
  multiplierMicros BigInt             @default(0)
  dayOfWeek        Int?
  startTime        String?
  endTime          String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
}

// ─── Combo Meals ───
model ComboMeal {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  price         Float
  priceMinor    BigInt   @default(0)
  items         String   @default("[]") // JSON array of menu item IDs
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

// ─── Append-only security and financial audit trail ───
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String   @default("")
  actorRole  String   @default("")
  sessionId  String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  sourceHash String   @default("")
  userAgent  String   @default("")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([action, createdAt])
}

// ─── Persisted, revocable staff sessions ───
model StaffSession {
  id         String    @id
  employeeId String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─── Shared, privacy-safe fixed-window rate-limit counters ───
model RateLimitCounter {
  key       String   @id
  scope     String
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, expiresAt])
  @@index([expiresAt])
}

// ─── Durable KDS transactional outbox ───
model KdsOutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  screenSlugs   Json
  payload       Json?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockToken     String?
  deliveredAt   DateTime?
  lastError     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deliveredAt, nextAttemptAt])
  @@index([lockedAt])
  @@index([createdAt])
}

// ─── Immutable payment event ledger ───
model PaymentEvent {
  id                String               @id @default(cuid())
  idempotencyKey    String               @unique
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventType         PaymentEventType
  method            PaymentMethod
  status            PaymentEventStatus   @default(succeeded)
  amountCents       Int
  tenderedCents     Int?
  changeCents       Int?
  currency          String               @default("USD")
  actorId           String?
  actorName         String               @default("")
  metadata          Json?
  registerSessionId String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  parentEventId     String?
  parentEvent       PaymentEvent?        @relation("PaymentEventReversals", fields: [parentEventId], references: [id], onDelete: Restrict)
  reversals         PaymentEvent[]       @relation("PaymentEventReversals")
  reasonCode        String               @default("")
  reason            String?
  createdAt         DateTime             @default(now())

  @@index([orderId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@index([registerSessionId, createdAt(sort: Desc)], map: "PaymentEvent_registerSession_createdAt_idx")
  @@index([parentEventId, createdAt(sort: Desc)], map: "PaymentEvent_parent_createdAt_idx")
  @@index([orderId, status, createdAt(sort: Desc)], map: "PaymentEvent_order_status_createdAt_idx")
}
