// Restaurant — Restaurant Management Platform
// PostgreSQL schema (bilingual EN/AR, KDS with unique URLs, modifier groups, courses)
// All business values are managed from the admin panel — DB defaults are minimal/empty.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  dine_in
  takeout
  delivery
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready
  completed
  cancelled
}

enum OrderItemStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum PaymentMethod {
  cash
  card
  split
}

enum PaymentStatus {
  unpaid
  partially_paid
  paid
  partially_refunded
  refunded
  voided
}

enum StaffRole {
  owner
  admin
  manager
  cashier
  server
  cook
  bartender
  host
  inventory_manager
  analyst
  staff
}

enum TableStatus {
  open
  seated
  ordered
  served
  paid
  cleaning
  reserved
}

enum TableShape {
  square
  round
}

enum ReservationStatus {
  confirmed
  seated
  completed
  cancelled
  no_show
}

enum WaitlistStatus {
  waiting
  notified
  seated
  cancelled
  no_show
}

enum CashMovementType {
  payin
  payout
  drop
  sale
  refund
  adjustment
  opening_float
  closing_adjustment
}

enum KdsScreenType {
  prep
  expo
  all
}

enum KdsLayoutType {
  grid
  compact
}

enum DynamicPricingType {
  happy_hour
  lunch_special
  surge
}

enum PaymentEventType {
  capture
  refund
  void
  adjustment
}

enum PaymentEventStatus {
  pending
  succeeded
  failed
  voided
}

enum CashRegisterSessionStatus {
  open
  closed
}

enum StockMovementType {
  opening_balance
  receipt
  waste
  adjustment_in
  adjustment_out
  production_consumption
  reversal
}

enum InventoryConsumptionState {
  pending
  consumed
  untracked
}

enum SupplierStatus {
  active
  inactive
}

enum PurchaseOrderStatus {
  draft
  submitted
  partially_received
  received
  cancelled
}

enum PurchaseReceiptStatus {
  posted
  reversed
}

enum TimeEventType {
  clock_in
  clock_out
  break_start
  break_end
}

enum TimeEventSource {
  kiosk
  manager
  import
  system
}

enum TimeShiftStatus {
  open
  closed
}

// ─── Restaurant-wide settings (singleton) ───
model RestaurantSettings {
  id                         String   @id @default("1")
  nameEn                     String   @default("")
  nameAr                     String   @default("")
  taglineEn                  String   @default("")
  taglineAr                  String   @default("")
  descriptionEn              String   @default("")
  descriptionAr              String   @default("")
  phone                      String   @default("")
  email                      String   @default("")
  addressEn                  String   @default("")
  addressAr                  String   @default("")
  latitude                   Float    @default(0)
  longitude                  Float    @default(0)
  taxRate                    Float    @default(0)
  // P1 exact value; scale 1_000_000. Globally omitted unless explicitly selected.
  taxRateMicros              BigInt   @default(0)
  currency                   String   @default("USD")
  currencySymbol             String   @default("$")
  deliveryFee                Float    @default(0)
  deliveryFeeMinor           BigInt   @default(0)
  minDeliveryOrder           Float    @default(0)
  minDeliveryOrderMinor      BigInt   @default(0)
  deliveryRadiusKm           Float    @default(0)
  avgPrepTimeMin             Int      @default(20)
  tipPresets                 String   @default("10,15,20")
  openTime                   String   @default("09:00")
  closeTime                  String   @default("23:00")
  timezone                   String   @default("UTC")
  operationalDayStartMinutes Int      @default(0)
  logoUrl                    String   @default("")
  heroImageUrl               String   @default("")
  facebookUrl                String   @default("")
  instagramUrl               String   @default("")
  twitterUrl                 String   @default("")
  whatsappUrl                String   @default("")
  giftCardAmounts            String   @default("25,50,75,100")
  statsOrdersServed          Int      @default(0)
  statsHappyCustomers        Int      @default(0)
  statsYearsService          Int      @default(0)
  // KDS timing thresholds (minutes)
  kdsGreenMin                Int      @default(10)
  kdsYellowMin               Int      @default(18)
  kdsRedMin                  Int      @default(25)
  soundOnNewTicket           Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

// ─── Menu ───
model MenuCategory {
  id           String     @id @default(cuid())
  nameEn       String
  nameAr       String
  icon         String     @default("🍽️")
  color        String     @default("#f59e0b")
  sortOrder    Int        @default(0)
  isAvailable  Boolean    @default(true)
  // Which kitchen station(s) handle this category (comma-separated station slugs, empty = all)
  stationSlugs String     @default("")
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id              String          @id @default(cuid())
  nameEn          String
  nameAr          String
  descriptionEn   String          @default("")
  descriptionAr   String          @default("")
  price           Float
  priceMinor      BigInt          @default(0)
  image           String          @default("")
  isAvailable     Boolean         @default(true)
  isPopular       Boolean         @default(false)
  isSpecial       Boolean         @default(false)
  isNew           Boolean         @default(false)
  preparationTime Int             @default(15)
  calories        Int             @default(0)
  // comma-separated allergens: gluten, dairy, nuts, eggs, seafood, soy, sesame
  allergens       String          @default("")
  // comma-separated dietary: vegetarian, vegan, gluten_free, halal, spicy
  dietary         String          @default("")
  sortOrder       Int             @default(0)
  categoryId      String
  category        MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups  ModifierGroup[]
  orderItems      OrderItem[]
  recipes         Recipe[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Modifier groups: required/optional, single/multi-select, priced options
model ModifierGroup {
  id         String           @id @default(cuid())
  nameEn     String
  nameAr     String
  isRequired Boolean          @default(false)
  minSelect  Int              @default(0)
  maxSelect  Int              @default(1) // 1 = single, >1 = multi
  sortOrder  Int              @default(0)
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ModifierOption {
  id               String            @id @default(cuid())
  nameEn           String
  nameAr           String
  price            Float             @default(0)
  priceMinor       BigInt            @default(0)
  isDefault        Boolean           @default(false)
  // preset tag: none, no, extra, side, light — for kitchen readability
  preset           String            @default("none")
  groupId          String
  group            ModifierGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipeComponents RecipeComponent[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ─── Customers ───
model Customer {
  id               String          @id @default(cuid())
  name             String
  phone            String          @unique
  email            String?
  loyaltyPoints    Int             @default(0)
  totalSpent       Float           @default(0)
  totalSpentMinor  BigInt          @default(0)
  visits           Int             @default(0)
  notes            String          @default("")
  orders           Order[]
  reservations     Reservation[]
  waitlistEntries  WaitlistEntry[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// ─── Orders ───
model Order {
  id                  String           @id @default(cuid())
  orderNumber         String           @unique
  type                OrderType        @default(dine_in)
  status              OrderStatus      @default(pending)
  customerName        String           @default("")
  customerPhone       String           @default("")
  deliveryAddress     String?
  notes               String?
  subtotal            Float            @default(0)
  subtotalMinor       BigInt           @default(0)
  taxAmount           Float            @default(0)
  taxAmountMinor      BigInt           @default(0)
  deliveryFee         Float            @default(0)
  deliveryFeeMinor    BigInt           @default(0)
  discountAmount      Float            @default(0)
  discountAmountMinor BigInt           @default(0)
  tipAmount           Float            @default(0)
  tipAmountMinor      BigInt           @default(0)
  total               Float            @default(0)
  totalMinor          BigInt           @default(0)
  paymentMethod       PaymentMethod    @default(cash)
  paymentStatus       PaymentStatus    @default(unpaid)
  // who took the order
  serverName          String           @default("")
  tableId             String?
  table               RestaurantTable? @relation(fields: [tableId], references: [id])
  customerId          String?
  customer            Customer?        @relation(fields: [customerId], references: [id])
  items               OrderItem[]
  paymentEvents       PaymentEvent[]
  estimatedReady      DateTime?
  completedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model OrderItem {
  id                        String                    @id @default(cuid())
  orderId                   String
  order                     Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId                String
  menuItem                  MenuItem                  @relation(fields: [menuItemId], references: [id])
  quantity                  Int                       @default(1)
  unitPrice                 Float
  unitPriceMinor            BigInt                    @default(0)
  // JSON string of selected modifier options [{id,nameEn,nameAr,price}]
  modifiers                 String                    @default("[]")
  notes                     String?
  totalPrice                Float
  totalPriceMinor           BigInt                    @default(0)
  status                    OrderItemStatus           @default(pending)
  // which kitchen station handles this item
  stationSlug               String                    @default("")
  // course number for course firing (1 = first course, 2 = main, etc.)
  course                    Int                       @default(1)
  hold                      Boolean                   @default(false) // held until expo fires it
  firedAt                   DateTime?
  readyAt                   DateTime?
  seatNumber                Int?
  inventoryConsumptionState InventoryConsumptionState @default(pending)
  inventoryRecipeId         String?
  inventoryRecipe           Recipe?                   @relation("OrderItemInventoryRecipe", fields: [inventoryRecipeId], references: [id], onDelete: Restrict)
  inventoryRecipeVersion    Int?
  inventoryConsumedAt       DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@index([inventoryConsumptionState, createdAt], map: "OrderItem_inventory_state_idx")
  @@index([inventoryRecipeId, createdAt], map: "OrderItem_inventory_recipe_idx")
}

// ─── Tables / Floor ───
model RestaurantTable {
  id           String        @id @default(cuid())
  number       Int           @unique
  capacity     Int           @default(4)
  section      String        @default("main") // main, patio, private, bar
  status       TableStatus   @default(open)
  shape        TableShape    @default(square)
  x            Float         @default(0)
  y            Float         @default(0)
  width        Float         @default(80)
  height       Float         @default(80)
  serverName   String        @default("")
  seatedAt     DateTime?
  orders       Order[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Reservations ───
model Reservation {
  id            String            @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?
  partySize     Int
  tableId       String?
  table         RestaurantTable?  @relation(fields: [tableId], references: [id])
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id])
  dateTime      DateTime
  status        ReservationStatus @default(confirmed)
  occasion      String?
  preference    String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ─── Waitlist ───
model WaitlistEntry {
  id            String         @id @default(cuid())
  customerName  String
  customerPhone String
  partySize     Int
  status        WaitlistStatus @default(waiting)
  estimatedWait Int            @default(15)
  notes         String?
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  seatedAt      DateTime?
  notifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ─── Offers / Promos ───
model SpecialOffer {
  id                  String   @id @default(cuid())
  titleEn             String
  titleAr             String
  descriptionEn       String   @default("")
  descriptionAr       String   @default("")
  discountPercent     Float    @default(0)
  discountBasisPoints Int      @default(0)
  image               String   @default("")
  isActive            Boolean  @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PromoCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  discountPercent     Float    @default(0)
  discountBasisPoints Int      @default(0)
  isActive            Boolean  @default(true)
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── Loyalty ───
model RewardTier {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  points    Int
  icon      String   @default("🎁")
  tier      String   @default("bronze") // bronze, silver, gold, platinum
  perkEn    String   @default("")
  perkAr    String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GiftCard {
  id            String    @id @default(cuid())
  code          String    @unique
  amount        Float
  amountMinor   BigInt    @default(0)
  balance       Float
  balanceMinor  BigInt    @default(0)
  purchaserName String
  recipientName String
  message       String?
  template      String    @default("birthday")
  isRedeemed    Boolean   @default(false)
  redeemedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Feedback / Testimonials / Newsletter ───
model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String?
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  commentEn String
  commentAr String
  avatar    String   @default("")
  stars     Int      @default(5)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ─── Staff ───
model Employee {
  id              String              @id @default(cuid())
  name            String
  pin             String              @unique
  role            StaffRole           @default(staff)
  hourlyWage      Float               @default(15.0)
  hourlyWageMinor BigInt               @default(0)
  isActive        Boolean             @default(true)
  email           String?
  phone           String?
  clockedIn       Boolean             @default(false)
  lastClockIn     DateTime?
  lastClockOut    DateTime?
  schedules       Schedule[]
  timeEvents      EmployeeTimeEvent[]
  shifts          EmployeeShift[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model Schedule {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      @default(1)
  startTime  String   @default("09:00")
  endTime    String   @default("17:00")
  role       String   @default("Server")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EmployeeTimeEvent {
  id              String             @id
  idempotencyKey  String             @unique(map: "EmployeeTimeEvent_idempotencyKey_key")
  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  eventType       TimeEventType
  source          TimeEventSource
  occurredAt      DateTime           @db.Timestamptz(3)
  operationalDate DateTime           @db.Date
  actorId         String?
  actorName       String             @default("")
  actorRole       String             @default("")
  reasonCode      String             @default("")
  reason          String?
  metadata        Json?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  clockInShift    EmployeeShift?     @relation("EmployeeShiftClockIn")
  clockOutShift   EmployeeShift?     @relation("EmployeeShiftClockOut")
  startedBreak    EmployeeBreak?     @relation("EmployeeBreakStart")
  endedBreak      EmployeeBreak?     @relation("EmployeeBreakEnd")

  @@index([employeeId, occurredAt(sort: Desc)], map: "EmployeeTimeEvent_employee_occurredAt_idx")
  @@index([operationalDate, occurredAt], map: "EmployeeTimeEvent_operationalDate_idx")
  @@index([eventType, createdAt(sort: Desc)], map: "EmployeeTimeEvent_type_createdAt_idx")
}

model EmployeeShift {
  id                 String                   @id
  employeeId         String
  employee           Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  status             TimeShiftStatus          @default(open)
  operationalDate    DateTime                 @db.Date
  startedAt          DateTime                 @db.Timestamptz(3)
  endedAt            DateTime?                @db.Timestamptz(3)
  clockInEventId     String                   @unique(map: "EmployeeShift_clockInEventId_key")
  clockInEvent       EmployeeTimeEvent        @relation("EmployeeShiftClockIn", fields: [clockInEventId], references: [id], onDelete: Restrict)
  clockOutEventId    String?                  @unique(map: "EmployeeShift_clockOutEventId_key")
  clockOutEvent      EmployeeTimeEvent?       @relation("EmployeeShiftClockOut", fields: [clockOutEventId], references: [id], onDelete: Restrict)
  grossSeconds       Int                      @default(0)
  breakSeconds       Int                      @default(0)
  paidSeconds        Int                      @default(0)
  hourlyWageMinor    BigInt
  baseLaborCostMinor BigInt                   @default(0)
  openedById         String?
  openedByName       String                   @default("")
  closedById         String?
  closedByName       String?
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  closedAt           DateTime?                @db.Timestamptz(3)
  breaks             EmployeeBreak[]
  adjustments        EmployeeTimeAdjustment[]

  @@index([employeeId, operationalDate(sort: Desc), startedAt(sort: Desc)], map: "EmployeeShift_employee_operationalDate_idx")
  @@index([status, startedAt], map: "EmployeeShift_status_startedAt_idx")
}

model EmployeeBreak {
  id              String             @id
  shiftId         String
  shift           EmployeeShift      @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  status          TimeShiftStatus    @default(open)
  startedAt       DateTime           @db.Timestamptz(3)
  endedAt         DateTime?          @db.Timestamptz(3)
  startEventId    String             @unique(map: "EmployeeBreak_startEventId_key")
  startEvent      EmployeeTimeEvent  @relation("EmployeeBreakStart", fields: [startEventId], references: [id], onDelete: Restrict)
  endEventId      String?            @unique(map: "EmployeeBreak_endEventId_key")
  endEvent        EmployeeTimeEvent? @relation("EmployeeBreakEnd", fields: [endEventId], references: [id], onDelete: Restrict)
  durationSeconds Int                @default(0)
  openedById      String?
  openedByName    String             @default("")
  closedById      String?
  closedByName    String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  closedAt        DateTime?          @db.Timestamptz(3)

  @@index([shiftId, startedAt], map: "EmployeeBreak_shift_startedAt_idx")
}

model EmployeeTimeAdjustment {
  id                  String        @id
  idempotencyKey      String        @unique(map: "EmployeeTimeAdjustment_idempotencyKey_key")
  shiftId             String
  shift               EmployeeShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  paidSecondsDelta    Int
  laborCostDeltaMinor BigInt
  reasonCode          String
  reason              String
  actorId             String
  actorName           String
  actorRole           String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)

  @@index([shiftId, createdAt], map: "EmployeeTimeAdjustment_shift_createdAt_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "EmployeeTimeAdjustment_actor_createdAt_idx")
}

// ─── Inventory ───
model Ingredient {
  id                   String                @id @default(cuid())
  name                 String
  unit                 String                @default("pcs")
  quantity             Float                 @default(0)
  quantityMicros       BigInt                @default(0)
  allowNegativeStock   Boolean               @default(false)
  lowThreshold         Float                 @default(10)
  costPerUnit          Float                 @default(0)
  // Unit cost uses scale 1_000_000 during the compatibility window.
  costPerUnitMicros    BigInt                @default(0)
  supplier             String?
  category             String?
  unitConversions      IngredientUnitConversion[]
  recipeComponents     RecipeComponent[]
  stockMovements       StockMovement[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseReceiptLines PurchaseReceiptLine[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
}

model IngredientUnitConversion {
  id           String     @id
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit         String
  toBaseMicros BigInt
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([ingredientId, unit], map: "IngredientUnitConversion_ingredient_unit_key")
  @@index([ingredientId, createdAt], map: "IngredientUnitConversion_ingredient_idx")
}

model Recipe {
  id                 String            @id
  creationKey        String            @unique(map: "Recipe_creationKey_key")
  menuItemId         String
  menuItem           MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  version            Int
  yieldMicros        BigInt            @default(1000000)
  isActive           Boolean           @default(true)
  createdById        String?
  createdByName      String            @default("")
  createdAt          DateTime          @default(now())
  supersededAt       DateTime?
  components         RecipeComponent[]
  consumedOrderItems OrderItem[]       @relation("OrderItemInventoryRecipe")

  @@unique([menuItemId, version], map: "Recipe_menuItem_version_key")
  @@index([menuItemId, createdAt(sort: Desc)], map: "Recipe_menuItem_createdAt_idx")
}

model RecipeComponent {
  id               String          @id
  recipeId         String
  recipe           Recipe          @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  ingredientId     String
  ingredient       Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  modifierOptionId String?
  modifierOption   ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)
  quantityMicros   BigInt
  createdAt        DateTime        @default(now())

  @@index([recipeId, createdAt], map: "RecipeComponent_recipe_idx")
  @@index([ingredientId, createdAt], map: "RecipeComponent_ingredient_idx")
  @@index([modifierOptionId], map: "RecipeComponent_modifier_idx")
}

model StockMovement {
  id                           String                @id
  idempotencyKey               String                @unique(map: "StockMovement_idempotencyKey_key")
  ingredientId                 String
  ingredient                   Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  movementType                 StockMovementType
  quantityDeltaMicros          BigInt
  unitCostMicros               BigInt                @default(0)
  totalCostMinor               BigInt                @default(0)
  balanceAfterMicros           BigInt                @default(0)
  sourceType                   String                @default("")
  sourceId                     String?
  sourceLineId                 String?
  reversalOfId                 String?
  reversalOf                   StockMovement?        @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals                    StockMovement[]       @relation("StockMovementReversal")
  purchaseReceiptLines         PurchaseReceiptLine[] @relation("PurchaseReceiptLineStockMovement")
  purchaseReceiptReversalLines PurchaseReceiptLine[] @relation("PurchaseReceiptLineReversalMovement")
  reasonCode                   String                @default("")
  reason                       String?
  actorId                      String?
  actorName                    String                @default("")
  metadata                     Json?
  occurredAt                   DateTime              @default(now())
  createdAt                    DateTime              @default(now())

  @@index([ingredientId, createdAt(sort: Desc)], map: "StockMovement_ingredient_createdAt_idx")
  @@index([sourceType, sourceId, sourceLineId], map: "StockMovement_source_idx")
  @@index([movementType, createdAt(sort: Desc)], map: "StockMovement_type_createdAt_idx")
  @@index([actorId, createdAt(sort: Desc)], map: "StockMovement_actor_createdAt_idx")
}

model WasteLog {
  id             String   @id @default(cuid())
  ingredientId   String?
  ingredientName String   @default("")
  quantity       Float    @default(0)
  reason         String   @default("expired")
  notes          String?
  reportedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Supplier {
  id             String          @id
  code           String          @unique(map: "Supplier_code_key")
  name           String
  contactName    String          @default("")
  phone          String          @default("")
  email          String          @default("")
  address        String          @default("")
  paymentTerms   String          @default("")
  notes          String?
  status         SupplierStatus  @default(active)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, name], map: "Supplier_status_name_idx")
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique(map: "PurchaseOrder_orderNumber_key")
  creationKey        String              @unique(map: "PurchaseOrder_creationKey_key")
  supplierId         String
  supplierRecord     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierCode       String              @default("")
  supplier           String
  currency           String              @default("USD")
  notes              String?
  status             PurchaseOrderStatus @default(draft)
  totalCost          Float               @default(0)
  totalCostMinor     BigInt              @default(0)
  expectedAt         DateTime?
  createdById        String?
  createdByName      String              @default("")
  submittedById      String?
  submittedByName    String?
  submittedAt        DateTime?
  cancelledById      String?
  cancelledByName    String?
  cancelledAt        DateTime?
  cancellationReason String?
  legacyImported     Boolean             @default(false)
  lines              PurchaseOrderLine[]
  receipts           PurchaseReceipt[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([supplierId, status, createdAt(sort: Desc)], map: "PurchaseOrder_supplier_status_createdAt_idx")
  @@index([status, expectedAt], map: "PurchaseOrder_status_expectedAt_idx")
}

model PurchaseOrderLine {
  id                            String                @id
  purchaseOrderId               String
  purchaseOrder                 PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lineNumber                    Int
  ingredientId                  String
  ingredient                    Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientName                String
  baseUnit                      String
  purchaseUnit                  String
  conversionToBaseMicros        BigInt
  orderedPurchaseQuantityMicros BigInt
  orderedBaseQuantityMicros     BigInt
  receivedBaseQuantityMicros    BigInt                @default(0)
  purchaseUnitCostMicros        BigInt
  baseUnitCostMicros            BigInt
  lineTotalMinor                BigInt
  notes                         String?
  receiptLines                  PurchaseReceiptLine[]
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  @@unique([purchaseOrderId, lineNumber], map: "PurchaseOrderLine_order_lineNumber_key")
  @@index([ingredientId, createdAt(sort: Desc)], map: "PurchaseOrderLine_ingredient_createdAt_idx")
  @@index([purchaseOrderId, receivedBaseQuantityMicros], map: "PurchaseOrderLine_order_received_idx")
}

model PurchaseReceipt {
  id              String                @id
  receiptNumber   String                @unique(map: "PurchaseReceipt_receiptNumber_key")
  idempotencyKey  String                @unique(map: "PurchaseReceipt_idempotencyKey_key")
  reversalKey     String?
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  status          PurchaseReceiptStatus @default(posted)
  totalCostMinor  BigInt                @default(0)
  notes           String?
  receivedById    String
  receivedByName  String
  occurredAt      DateTime              @default(now())
  reversedById    String?
  reversedByName  String?
  reversedAt      DateTime?
  reversalReason  String?
  lines           PurchaseReceiptLine[]
  createdAt       DateTime              @default(now())

  @@index([purchaseOrderId, createdAt(sort: Desc)], map: "PurchaseReceipt_order_createdAt_idx")
  @@index([status, createdAt(sort: Desc)], map: "PurchaseReceipt_status_createdAt_idx")
}

model PurchaseReceiptLine {
  id                      String            @id
  receiptId               String
  receipt                 PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseOrderLineId     String
  purchaseOrderLine       PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  ingredientId            String
  ingredient              Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  ingredientName          String
  submittedUnit           String
  submittedQuantityMicros BigInt
  conversionToBaseMicros  BigInt
  baseQuantityMicros      BigInt
  purchaseUnitCostMicros  BigInt
  baseUnitCostMicros      BigInt
  totalCostMinor          BigInt
  stockMovementId         String            @unique(map: "PurchaseReceiptLine_stockMovement_key")
  stockMovement           StockMovement     @relation("PurchaseReceiptLineStockMovement", fields: [stockMovementId], references: [id], onDelete: Restrict)
  reversalMovementId      String?
  reversalMovement        StockMovement?    @relation("PurchaseReceiptLineReversalMovement", fields: [reversalMovementId], references: [id], onDelete: Restrict)
  createdAt               DateTime          @default(now())

  @@unique([receiptId, purchaseOrderLineId], map: "PurchaseReceiptLine_receipt_orderLine_key")
  @@index([purchaseOrderLineId, createdAt(sort: Desc)], map: "PurchaseReceiptLine_orderLine_createdAt_idx")
  @@index([ingredientId, createdAt(sort: Desc)], map: "PurchaseReceiptLine_ingredient_createdAt_idx")
}

// ─── Cash registers, sessions, and drawer ledger ───
model CashRegister {
  id                                 String                @id
  code                               String                @unique(map: "CashRegister_code_key")
  name                               String
  deviceId                           String                @unique(map: "CashRegister_deviceId_key")
  location                           String                @default("")
  discrepancyApprovalThresholdMinor BigInt                @default(0)
  isActive                           Boolean               @default(true)
  sessions                           CashRegisterSession[]
  createdAt                          DateTime              @default(now())
  updatedAt                          DateTime              @updatedAt

  @@index([isActive, name], map: "CashRegister_active_name_idx")
}

model CashRegisterSession {
  id                String                    @id
  registerId        String
  register          CashRegister              @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openKey           String
  status            CashRegisterSessionStatus @default(open)
  openingFloatMinor BigInt
  openedById        String
  openedByName      String                    @default("")
  openedAt          DateTime                  @default(now())
  closedAt          DateTime?
  close             CashRegisterClose?
  cashEntries       CashDrawerEntry[]
  paymentEvents     PaymentEvent[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([registerId, openKey], map: "CashRegisterSession_register_openKey_key")
  @@index([registerId, openedAt(sort: Desc)], map: "CashRegisterSession_register_openedAt_idx")
  @@index([openedById, status], map: "CashRegisterSession_openedBy_status_idx")
}

model CashRegisterClose {
  id                String              @id
  sessionId         String              @unique(map: "CashRegisterClose_sessionId_key")
  session           CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  closeKey          String              @unique(map: "CashRegisterClose_closeKey_key")
  expectedCashMinor BigInt
  countedCashMinor  BigInt
  discrepancyMinor  BigInt
  thresholdMinor    BigInt
  approvalRequired  Boolean             @default(false)
  approvedById      String?
  approvedByName    String?
  approvalReason    String?
  closedById        String
  closedByName      String              @default("")
  note              String?
  createdAt         DateTime            @default(now())

  @@index([createdAt(sort: Desc)], map: "CashRegisterClose_createdAt_idx")
  @@index([approvedById, createdAt(sort: Desc)], map: "CashRegisterClose_approvedBy_createdAt_idx")
}

model CashDrawerEntry {
  id                String               @id @default(cuid())
  type              CashMovementType     @default(payin)
  amount            Float                @default(0)
  amountMinor       BigInt               @default(0)
  note              String?
  createdBy         String?
  registerSessionId String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  @@index([registerSessionId, createdAt(sort: Desc)], map: "CashDrawerEntry_registerSession_createdAt_idx")
}

// ─── Notifications ───
model Notification {
  id        String   @id @default(cuid())
  type      String   @default("info")
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── KDS: Stations + Screens (each screen = unique URL) ───
model KitchenStation {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  icon          String   @default("ChefHat")
  color         String   @default("#f59e0b")
  targetPrepMin Int      @default(15)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model KitchenScreen {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String        @default("")
  // comma-separated station slugs to display; empty = all stations
  stationFilter  String        @default("")
  screenType     KdsScreenType @default(prep)
  layoutType     KdsLayoutType @default(grid)
  autoRefreshSec Int           @default(10)
  showCompleted  Boolean       @default(false)
  maxOrders      Int           @default(0)
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
}

// ─── Dynamic Pricing (happy hour etc.) ───
model DynamicPricing {
  id               String             @id @default(cuid())
  nameEn           String
  nameAr           String
  type             DynamicPricingType @default(happy_hour)
  multiplier       Float              @default(1.0)
  multiplierMicros BigInt             @default(0)
  dayOfWeek        Int?
  startTime        String?
  endTime          String?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now()) @updatedAt
}

// ─── Combo Meals ───
model ComboMeal {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  price         Float
  priceMinor    BigInt   @default(0)
  items         String   @default("[]") // JSON array of menu item IDs
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

// ─── Append-only security and financial audit trail ───
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String   @default("")
  actorRole  String   @default("")
  sessionId  String?
  action     String
  entityType String
  entityId   String?
  requestId  String?
  sourceHash String   @default("")
  userAgent  String   @default("")
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([sessionId, createdAt])
  @@index([action, createdAt])
}

// ─── Persisted, revocable staff sessions ───
model StaffSession {
  id         String    @id
  employeeId String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

// ─── Shared, privacy-safe fixed-window rate-limit counters ───
model RateLimitCounter {
  key       String   @id
  scope     String
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, expiresAt])
  @@index([expiresAt])
}

// ─── Durable KDS transactional outbox ───
model KdsOutboxEvent {
  id            String    @id @default(cuid())
  eventType     String
  screenSlugs   Json
  payload       Json?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockToken     String?
  deliveredAt   DateTime?
  lastError     String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deliveredAt, nextAttemptAt])
  @@index([lockedAt])
  @@index([createdAt])
}

// ─── Immutable payment event ledger ───
model PaymentEvent {
  id                String               @id @default(cuid())
  idempotencyKey    String               @unique
  orderId           String
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  eventType         PaymentEventType
  method            PaymentMethod
  status            PaymentEventStatus   @default(succeeded)
  amountCents       Int
  tenderedCents     Int?
  changeCents       Int?
  currency          String               @default("USD")
  actorId           String?
  actorName         String               @default("")
  metadata          Json?
  registerSessionId String?
  registerSession   CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: Restrict)
  parentEventId     String?
  parentEvent       PaymentEvent?        @relation("PaymentEventReversals", fields: [parentEventId], references: [id], onDelete: Restrict)
  reversals         PaymentEvent[]       @relation("PaymentEventReversals")
  reasonCode        String               @default("")
  reason            String?
  createdAt         DateTime             @default(now())

  @@index([orderId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
  @@index([registerSessionId, createdAt(sort: Desc)], map: "PaymentEvent_registerSession_createdAt_idx")
  @@index([parentEventId, createdAt(sort: Desc)], map: "PaymentEvent_parent_createdAt_idx")
  @@index([orderId, status, createdAt(sort: Desc)], map: "PaymentEvent_order_status_createdAt_idx")
}
